  m_Script: {fileID: 11500000, guid: eb4b99d52344f1944ac1c6613b7e1846, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  tutorialLines:
  - levelIndex: 0
    lines:
    - This is a game about a weird world with 2 sides
    - Press 'F' or flip button to check the other side
    - Also there's a restart button on the top left, or press 'R'
  - levelIndex: 1
    lines:
    - '"Can the other world be different from this world?"'
    - '"Do we both have to win at the same time?"'
  - levelIndex: 4
    lines:
    - '"Hey I''m stuck!"'
    - '"Can that teleport gate help me out?"'
  - levelIndex: 6
    lines:
    - What is this weird block? How can I unblock this block?
  - levelIndex: 8
    lines:
    - The white character will be twice slower now
  tutorialCanvas: {fileID: 2749336303331509451}
